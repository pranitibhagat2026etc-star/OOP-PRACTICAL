#include <iostream>
using namespace std;

// Function template
template <class T>
T add(T a, T b)
{
    return a + b;
}

// Class template
template <class T>
class Calculator
{
public:
    T a, b;

    // Function to display the sum
    void display(T x, T y)
    {
        a = x;
        b = y;
        cout << "Sum using class template: " << a + b << endl;
    }
};

int main()
{
    // Calling function template with integers
    cout << "Sum using function template: "
         << add<int>(10, 20) << endl;

    // Creating an object of class template
    Calculator<int> c;

    // Calling the class template function
    c.display(30, 40);

    return 0;
}
