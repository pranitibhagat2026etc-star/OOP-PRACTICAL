
#include <iostream>
using namespace std;

// Function to calculate factorial of an integer
int factorial(int n)
{
    int fact = 1;

    // Calculate factorial
    for (int i = 1; i <= n; i++)
        fact = fact * i;

    return fact;
}

// Function to calculate factorial of a long integer
long int factorial(long int n)
{
    long int fact = 1;

    // Calculate factorial
    for (long int i = 1; i <= n; i++)
        fact = fact * i;

    return fact;
}

int main()
{
    int a;
    long int b;

    // Accept integer input
    cout << "Enter an integer: ";
    cin >> a;

    // Accept long integer input
    cout << "Enter a long integer: ";
    cin >> b;

    // Call factorial function for integer
    cout << "Factorial of integer = " << factorial(a) << endl;

    // Call factorial function for long integer
    cout << "Factorial of long integer = " << factorial(b) << endl;

    return 0;
}

