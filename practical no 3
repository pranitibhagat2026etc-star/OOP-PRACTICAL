#include <iostream>
using namespace std;
void read(int a[], int n)
{
    cout << "Enter " << n << " numbers: ";
    for(int i = 0; i < n; i++)
    {
        cin >> a[i];
    }
}

void swapNum(int &x, int &y)
{
    int temp = x;
    x = y;
    y = temp;
}

void sortArray(int a[], int n)
{
    for(int i = 0; i < n - 1; i++)
    {
        for(int j = 0; j < n - 1 - i; j++)
        {
            if(a[j] > a[j + 1])
            {
                swapNum(a[j], a[j + 1]);
            }
        }
    }
}

void display(int a[], int n)
{
    for(int i = 0; i < n; i++)
    {
        cout << a[i] << " ";
    }
}

int main()
{
    int a[5];

    read(a, 5);

    cout << "Before sorting: ";
    display(a, 5);

    sortArray(a, 5);

    cout << "\nAfter sorting: ";
    display(a, 5);

    return 0;
}
