#include <iostream>

class Complex {
public:
    double real, imag;

    Complex(double r, double i) {
        real = r;
        imag = i;
    }

    Complex(const Complex &other) {
        real = other.real;
        imag = other.imag;
    }

    void display() {
        std::cout << real << " + " << imag << "i" << std::endl;
    }
};

int main() {
    Complex c1(3.0, 4.0);
    Complex c2 = c1;

    std::cout << "c1: "; c1.display();
    std::cout << "c2: "; c2.display();

    return 0;
}
